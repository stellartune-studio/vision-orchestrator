# Copy to .env. Server-side only — never ship to the frontend bundle,
# logs, or project exports.

# Director chat LLM: "mock" (offline, deterministic), "openai-compatible",
# or "kaname" (installed Kaname CLI + .kaname/agents/ profile)
LLM_PROVIDER=mock

# OpenAI-compatible provider (only when LLM_PROVIDER=openai-compatible)
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=
# OPENAI_API_KEY=

# Kaname provider (only when LLM_PROVIDER=kaname). Kaname owns credential
# resolution — do NOT copy provider keys into this file.
# KANAME_BIN=kaname
# KANAME_AGENT=vision-director
# KANAME_WORKDIR=<repo root containing .kaname/>

# Generation backend: "mock" (writes a stub image, offline) or "comfy-sdk".
# Real Comfy generation defaults to MOSS-Image text-to-image and Wan 2.2
# image-to-video. A limited API smoke passed; broader validation remains pending.
GEN_BACKEND=mock

# Optional: select the dedicated one-source Qwen editing screen instead of
# the default MOSS text-to-image path. Qwen weights have separate terms.
# GEN_PROFILE=qwen-image-2.1-turbo-edit-single

# VO-managed environment: ./scripts/setup-comfy.ps1 -Start
# Dedicated SDK proxy on 8289 and read-only node/model discovery on 8288.
# Existing environments may use different loopback ports; never update/restart them implicitly.
# For Comfy Cloud leave unset (requires a paid API key as COMFY_API_KEY).
# COMFY_BASE_URL=http://127.0.0.1:8289
# COMFY_DISCOVERY_URL=http://127.0.0.1:8288
# COMFY_API_KEY=

# Optional path override for the pinned Qwen reference-edit graph. The file
# must have the exact workflow SHA and node contract validated at startup.
# COMFY_QWEN21_WORKFLOW=<path to qwen21_img2img.json>

# Optional local editing tools for generated-video trim / SRT captions.
# Install both tools yourself; the app never downloads or installs them.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# HTTP port for the server (Vite dev proxies /api here)
PORT=8787
